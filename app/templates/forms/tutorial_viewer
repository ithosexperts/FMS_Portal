<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Know-How Viewer · {{ stage_no }}</title>
  <style>
    :root { color-scheme:light; --ink:#17243b; --muted:#63738a; --line:#dfe6ef; --panel:#fff; --bg:#f3f6fa; --blue:#315fc6; --blue-soft:#edf3ff; }
    * { box-sizing:border-box; }
    html,body { margin:0; min-height:100%; background:var(--bg); color:var(--ink); font-family:Inter,Segoe UI,Arial,sans-serif; }
    body { min-height:100vh; }
    #top-bar { min-height:70px; display:flex; align-items:center; justify-content:space-between; gap:18px; padding:12px 22px; background:#fff; border-bottom:1px solid var(--line); box-shadow:0 2px 8px rgba(30,45,65,.05); position:sticky; top:0; z-index:20; }
    .brand { display:flex; align-items:center; gap:14px; min-width:0; }
    .brand img { width:auto; max-width:200px; height:34px; object-fit:contain; }
    .brand-title { font-size:16px; font-weight:850; letter-spacing:.025em; }
    .brand-sub { margin-top:4px; font-size:11px; color:var(--muted); }
    .toolbar { display:flex; align-items:center; gap:9px; flex-shrink:0; }
    .tool-btn { border:1px solid var(--line); border-radius:9px; padding:9px 12px; background:#fff; color:#526174; cursor:pointer; display:inline-flex; align-items:center; gap:6px; font-weight:750; font-size:12px; }
    .view-only { background:#f0f3f7; border:1px solid #e0e6ed; color:#58687b; border-radius:9px; padding:9px 12px; text-transform:uppercase; letter-spacing:.05em; font-size:10px; font-weight:850; white-space:nowrap; }
    main { width:min(1240px,calc(100% - 32px)); margin:22px auto 38px; }
    .page-heading { margin-bottom:16px; }
    .page-heading h1 { margin:0; font-size:22px; font-weight:850; }
    .page-heading p { margin:7px 0 0; color:var(--muted); font-size:13px; line-height:1.5; }
    .error { border:1px solid #fed7aa; background:#fff7ed; color:#9a4d12; padding:13px 16px; border-radius:10px; margin:0 0 16px; font-size:13px; }
    .chooser,.viewer-card { background:white; border:1px solid var(--line); border-radius:14px; box-shadow:0 6px 20px rgba(25,40,62,.045); overflow:hidden; }
    .chooser { padding:17px; }
    .section-title { margin:0 0 12px; font-size:14px; font-weight:850; }
    .categories { display:flex; flex-wrap:wrap; gap:8px; margin-bottom:14px; }
    .category-btn { cursor:pointer; border:1px solid var(--line); border-radius:9px; background:#fff; color:#526174; padding:9px 13px; font-size:12px; font-weight:800; }
    .category-btn.active { color:#244da9; border-color:#b8ccff; background:var(--blue-soft); }
    .resource-list { display:flex; flex-wrap:wrap; gap:9px; }
    .resource-btn { display:flex; align-items:center; gap:9px; max-width:100%; border:1px solid #dfe6ef; background:#fff; color:#2d3e56; border-radius:10px; padding:10px 13px; cursor:pointer; text-align:left; font-size:12px; font-weight:750; }
    .resource-btn:hover { border-color:#a9bff9; background:#f8faff; }
    .resource-btn.active { border-color:var(--blue); background:#edf3ff; box-shadow:0 0 0 2px rgba(49,95,198,.08); }
    .resource-btn[hidden] { display:none !important; }
    .resource-type { color:var(--blue); border-radius:5px; background:#eaf0ff; padding:4px 6px; font-size:9px; font-weight:900; text-transform:uppercase; letter-spacing:.04em; white-space:nowrap; }
    .resource-name { overflow-wrap:anywhere; }
    .no-resources { padding:18px; background:#f8fafc; border:1px dashed #cad5e3; color:var(--muted); border-radius:10px; font-size:12px; }
    .viewer-card { margin-top:18px; }
    .viewer-head { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding:14px 17px; border-bottom:1px solid #edf1f6; }
    .viewer-title { font-size:14px; font-weight:850; overflow-wrap:anywhere; }
    .viewer-meta { margin-top:4px; color:var(--muted); font-size:11px; }
    .viewer-preview { position:relative; min-height:440px; height:min(68vh,780px); background:#e9edf3; display:flex; align-items:center; justify-content:center; overflow:hidden; }
    .viewer-preview.empty-preview { height:auto; min-height:250px; }
    .viewer-preview iframe,.viewer-preview video,.viewer-preview img { display:block; width:100%; height:100%; border:0; background:white; object-fit:contain; }
    .viewer-preview video { background:#10151d; }
    .viewer-preview img { max-height:780px; }
    .placeholder { max-width:560px; padding:30px; text-align:center; color:var(--muted); font-size:13px; line-height:1.6; }
    .placeholder strong { display:block; margin-bottom:8px; color:#34445b; font-size:16px; }
    .preview-note { padding:10px 15px; border-top:1px solid #edf1f6; background:#fbfcfe; color:var(--muted); font-size:11px; line-height:1.5; }
    .frame-blocker { position:absolute; z-index:5; top:0; height:58px; background:transparent; }
    .frame-blocker.popout { right:0; width:58px; }
    .frame-blocker.download { right:58px; width:122px; }
    .fullscreen #top-bar { position:relative; }
    @media(max-width:700px) { #top-bar { align-items:flex-start; flex-wrap:wrap; padding:12px; } .brand img { max-width:140px; height:28px; } .brand-title { font-size:14px; } .toolbar { margin-left:auto; } main { width:calc(100% - 20px); margin-top:12px; } .viewer-preview { min-height:300px; height:52vh; } }
  </style>
</head>
<body>
  <header id="top-bar">
    <div class="brand">
      <img src="/static/logo.png" alt="HoseXperts" onerror="this.style.display='none'">
      <div>
        <div class="brand-title">KNOW-HOW VIEWER</div>
        <div class="brand-sub">{{ fms_name }} · {{ stage_no }}{% if stage_name %} — {{ stage_name }}{% endif %} · App ID: {{ app_id or '-' }} · Task ID: {{ task_id }}</div>
        {% if guide_name %}<div class="brand-sub">{{ guide_name }}</div>{% endif %}
      </div>
    </div>
    <div class="toolbar">
      <button type="button" class="tool-btn" onclick="toggleFullScreen()" title="Full Screen Mode">⛶ Full Screen</button>
      <div class="view-only" title="This viewer does not provide a download button">🔒 View Only</div>
    </div>
  </header>

  <main>
    <div class="page-heading">
      <h1>Videos &amp; Attachments</h1>
      <p>Choose a video or attachment above. The selected item will appear in the viewer below.</p>
    </div>

    {% if load_error %}<div class="error" role="status">{{ load_error }}</div>{% endif %}

    <section class="chooser" aria-labelledby="choose-resources">
      <h2 id="choose-resources" class="section-title">Select a resource</h2>
      <div class="categories" role="group" aria-label="Filter resources">
        <button type="button" class="category-btn active" data-category="all">All resources ({{ videos|length + attachments|length }})</button>
        <button type="button" class="category-btn" data-category="video">Attached Videos ({{ videos|length }})</button>
        <button type="button" class="category-btn" data-category="attachment">Attachments ({{ attachments|length }})</button>
      </div>
      {% if videos or attachments %}
      <div class="resource-list" id="resource-list">
        {% for item in videos %}
        <button type="button" class="resource-btn" data-resource-button data-kind="video" data-url="{{ item.url }}" data-title="{{ item.name }}">
          <span class="resource-type">Video</span><span class="resource-name">{{ item.name }}</span>
        </button>
        {% endfor %}
        {% for item in attachments %}
        <button type="button" class="resource-btn" data-resource-button data-kind="attachment" data-url="{{ item.url }}" data-title="{{ item.name }}">
          <span class="resource-type">Attachment</span><span class="resource-name">{{ item.name }}</span>
        </button>
        {% endfor %}
      </div>
      {% else %}
      <div class="no-resources">No videos or attachments are configured for this App ID and Stage No in FMS_Config.InputGuide.</div>
      {% endif %}
    </section>

    <section class="viewer-card" aria-label="Selected resource preview">
      <div class="viewer-head">
        <div><div id="viewer-title" class="viewer-title">Nothing selected yet</div><div id="viewer-meta" class="viewer-meta">Select a resource above to view it here.</div></div>
      </div>
      <div id="viewer-preview" class="viewer-preview empty-preview">
        <div class="placeholder"><strong>Choose a video or attachment</strong>Click one of the resource buttons above. Its preview will open below without navigating away from this page.</div>
      </div>
      <div class="preview-note" id="preview-note">View-only interface: no download button is provided. External hosts may control their own playback, embedding, or download behavior.</div>
    </section>
  </main>

  <script>
    // Interface-level view-only measures only; browser/devtools/screen capture cannot be fully blocked.
    document.addEventListener('contextmenu', event => event.preventDefault());
    document.addEventListener('keydown', event => {
      const key = String(event.key || '').toLowerCase();
      if ((event.ctrlKey || event.metaKey) && ['s','p','u'].includes(key)) event.preventDefault();
    });

    function safeHttpUrl(value) {
      try { const url = new URL(value, window.location.href); return ['http:', 'https:'].includes(url.protocol) ? url : null; }
      catch (_) { return null; }
    }
    function videoEmbedUrl(url) {
      const host = url.hostname.replace(/^www\./i, '').toLowerCase();
      let id = '';
      if (host === 'youtu.be') id = url.pathname.split('/').filter(Boolean)[0] || '';
      if (['youtube.com','m.youtube.com','music.youtube.com'].includes(host)) {
        if (url.pathname === '/watch') id = url.searchParams.get('v') || '';
        else if (/^\/(embed|shorts|live)\//.test(url.pathname)) id = url.pathname.split('/')[2] || '';
      }
      if (id && /^[\w-]{6,}$/.test(id)) return 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(id) + '?rel=0&playsinline=1';
      if (host === 'vimeo.com' || host === 'player.vimeo.com') {
        const vimeoId = url.pathname.split('/').filter(Boolean).pop() || '';
        if (/^\d+$/.test(vimeoId)) return 'https://player.vimeo.com/video/' + vimeoId + '?dnt=1';
      }
      return '';
    }
    function drivePreviewUrl(url) {
      const host = url.hostname.toLowerCase();
      if (!host.endsWith('drive.google.com') && !host.endsWith('docs.google.com')) return '';
      const match = url.pathname.match(/\/file\/d\/([^/]+)/i);
      const id = match ? match[1] : (url.searchParams.get('id') || '');
      return id ? 'https://drive.google.com/file/d/' + encodeURIComponent(id) + '/preview' : '';
    }
    function showMessage(shell, strong, detail) {
      shell.classList.add('empty-preview');
      const box = document.createElement('div'); box.className = 'placeholder';
      const heading = document.createElement('strong'); heading.textContent = strong;
      const text = document.createElement('div'); text.textContent = detail;
      box.append(heading, text); shell.replaceChildren(box);
    }
    function addIframe(shell, src, title) {
      shell.classList.remove('empty-preview');
      const frame = document.createElement('iframe');
      frame.src = src; frame.title = title || 'Resource preview'; frame.loading = 'eager';
      frame.referrerPolicy = 'no-referrer-when-downgrade'; frame.setAttribute('allowfullscreen','');
      frame.setAttribute('allow','autoplay; encrypted-media; picture-in-picture; fullscreen');
      shell.replaceChildren(frame);
      const popout = document.createElement('div'); popout.className = 'frame-blocker popout'; popout.title = 'Pop-out controls are covered in view-only mode';
      const download = document.createElement('div'); download.className = 'frame-blocker download'; download.title = 'Download toolbar area covered in view-only mode';
      shell.append(popout, download);
    }
    function renderSelected(button) {
      const rawUrl = button.dataset.url || '';
      const title = button.dataset.title || 'Resource';
      const kind = button.dataset.kind || 'attachment';
      const url = safeHttpUrl(rawUrl);
      const shell = document.getElementById('viewer-preview');
      document.getElementById('viewer-title').textContent = title;
      document.getElementById('viewer-meta').textContent = (kind === 'video' ? 'Attached Video' : 'Attachment') + ' · view-only preview';
      document.getElementById('preview-note').textContent = 'If the preview does not appear, the external website may block embedding. Ask the administrator to store a supported preview/share URL in FMS_Config.InputGuide.';
      if (!url) { showMessage(shell, 'Invalid resource URL', 'Ask an administrator to check the matching InputGuide value.'); return; }
      document.querySelectorAll('[data-resource-button]').forEach(btn => btn.classList.toggle('active', btn === button));
      const path = url.pathname.toLowerCase();
      const isVideoFile = /\.(mp4|webm|ogg|mov|m4v)(?:$)/i.test(path);
      const isImageFile = /\.(png|jpe?g|gif|webp|svg|avif)(?:$)/i.test(path);
      const isPdfFile = /\.pdf$/i.test(path);
      if (kind === 'video' && isVideoFile) {
        shell.classList.remove('empty-preview');
        const video = document.createElement('video');
        video.controls = true; video.preload = 'metadata'; video.playsInline = true;
        video.setAttribute('controlsList','nodownload noremoteplayback'); video.setAttribute('disablePictureInPicture','');
        video.src = url.href; shell.replaceChildren(video); return;
      }
      if (kind === 'attachment' && isImageFile) {
        shell.classList.remove('empty-preview'); const image = document.createElement('img');
        image.src = url.href; image.alt = title; image.draggable = false; shell.replaceChildren(image); return;
      }
      const embed = kind === 'video' ? videoEmbedUrl(url) : '';
      const drive = drivePreviewUrl(url);
      if (embed) { addIframe(shell, embed, title); return; }
      if (drive) { addIframe(shell, drive, title); return; }
      // Generic page/online document. Some hosts disallow iframe embeds; fallback guidance stays visible below.
      addIframe(shell, url.href, title);
    }
    document.querySelectorAll('[data-category]').forEach(categoryButton => {
      categoryButton.addEventListener('click', () => {
        const filter = categoryButton.dataset.category || 'all';
        document.querySelectorAll('[data-category]').forEach(btn => btn.classList.toggle('active', btn === categoryButton));
        document.querySelectorAll('[data-resource-button]').forEach(btn => {
          btn.hidden = filter !== 'all' && btn.dataset.kind !== filter;
        });
      });
    });
    document.querySelectorAll('[data-resource-button]').forEach(button => {
      button.addEventListener('click', () => {
        renderSelected(button);
        document.getElementById('viewer-preview').scrollIntoView({behavior:'smooth',block:'start'});
      });
    });
    function toggleFullScreen() {
      if (!document.fullscreenElement) document.documentElement.requestFullscreen?.().catch(() => {});
      else document.exitFullscreen?.();
    }
    document.addEventListener('fullscreenchange', () => document.body.classList.toggle('fullscreen', Boolean(document.fullscreenElement)));
  </script>
</body>
</html>
