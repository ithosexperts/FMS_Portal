# ==========================================================
# FMS Portal - Environment Configuration
# Copy this file to ".env" for local development.
# On Render, set these as Environment Variables in the dashboard.
# ==========================================================

# Base URLs of the shared portal APIs (same APIs used by every portal).
# Fill in the real values once known - nothing else in the code needs to change.
API_1_URL=https://api.hosexperts.com:85/apiv2.php
API_2_URL=https://api.hosexperts.com:85/apiv3.php

# Optional bearer/service token forwarded to both APIs, if required.
API_AUTH_TOKEN=

APP_NAME=FMS Portal
ENVIRONMENT=development

# Public base URL of THIS deployment, used to build deep links / QR codes.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# HTTP timeout (seconds) for outbound API calls.
REQUEST_TIMEOUT=15

# Port Render (or local uvicorn) should bind to.
PORT=8000
