# ==========================================================
# FMS Portal - Environment Configuration
# Copy this file to ".env" for local development.
# On Render, set these as Environment Variables in the dashboard.
# ==========================================================

# Base URLs of the shared portal APIs (same APIs used by every portal).
# Fill in the real values once known - nothing else in the code needs to change.
API_1_URL=https://example.com/api1
API_2_URL=https://example.com/api2

# Optional bearer/service token forwarded to both APIs, if required.
API_AUTH_TOKEN=

APP_NAME=FMS Portal
ENVIRONMENT=development

# Public base URL of THIS deployment, used to build deep links / QR codes.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# HTTP timeout (seconds) for outbound API calls.
REQUEST_TIMEOUT=15

# Port Render (or local uvicorn) should bind to.
PORT=8000

# Optional One Portal -> Comments launcher (blank disables widget rendering)
COMMENTS_ORIGIN=https://comments-app-4aw2.onrender.com
ONE_PORTAL_ORIGIN=https://one-portal-blmn.onrender.com/portal

# CEOITBOX WhatsApp notifications. Keep credentials blank here and set them securely.
WHATSAPP_API_URL=https://app.ceoitbox.com/api/v1/message/create
WHATSAPP_API_USERNAME=HoseXperts
WHATSAPP_API_PASSWORD=!Password@1234
WHATSAPP_CHANNEL_ID=196998
WHATSAPP_TEST_MODE=false
WHATSAPP_TEST_NUMBER=9814390048
# One Portal SSO (set these only when this deployment is configured for SSO)
ONE_PORTAL_AUTH_ENABLED=false
ONE_PORTAL_IDENTITY_CAPTURE_ENABLED=true
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
FMS_SSO_SECRET=
SSO_SESSION_MINUTES=480
SSO_COOKIE_SAMESITE=none
FMS_DB_TARGET=
